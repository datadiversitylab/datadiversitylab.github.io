---
permalink: '/sitemap.xml'
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.all %}
  {%- if item.url and not item.data.noSitemap and item.url != '/sitemap.xml' and item.url != '/404.html' and not item.url.startsWith('/admin') %}
<url>
  <loc>https://datadiversitylab.github.io{{ item.url }}</loc>
</url>
  {%- endif %}
{%- endfor %}
<url>
  <loc>https://datadiversitylab.github.io/ACC/</loc>
</url>
</urlset>